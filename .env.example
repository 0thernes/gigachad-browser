# Copy to .env if you prefer environment variables over config.json.
# Never commit .env or config.json.

# GIGACHAD_PYTHON=C:\Path\To\python.exe
# GIGACHAD_SIDECAR_PORT=8000
# GIGACHAD_LLM_BASE_URL=http://127.0.0.1:11434/v1
# GIGACHAD_LLM_API_KEY=
# GIGACHAD_LOCAL_MODEL=
# GIGACHAD_OMNI_MODEL=
# OPENROUTER_API_KEY=
# GIGACHAD_OPENROUTER_MODEL=
# ELEVENLABS_API_KEY=
# GIGACHAD_ELEVENLABS_MODEL=
# GIGACHAD_ELEVENLABS_VOICE=
# GIGACHAD_LLAMA_SERVER=
# GIGACHAD_LLAMA_MODEL=
# GIGACHAD_LLAMA_AUTOSTART=0
# GIGACHAD_YTDLP=
# GIGACHAD_EMBED_MODEL=
# GIGACHAD_NER_MODEL=
# Optional neural TTS requires an explicit model repository and voice.
# GIGACHAD_KOKORO_MODEL=
# GIGACHAD_KOKORO_VOICE=
# GIGACHAD_KOKORO_LANGUAGE=a
# Explicit profile and startup action policy (off by default).
# GIGACHAD_PROFILE_DIR=C:\Path\To\DedicatedBrowserProfile
# GIGACHAD_AUTONOMY_ON_STARTUP=0
# GIGACHAD_AUTO_SIDECAR=1
# Explicit opt-in: screenshots sent to remote AI providers are not PII-redacted.
# GIGACHAD_ALLOW_CLOUD_IMAGES=0

# Local SOCKS5 port (application default 9050; use 9150 for an existing Tor Browser client).
# An explicit environment port overrides the configured port. No direct onion fallback.
# GIGACHAD_TOR_SOCKS_PORT=9050
# Optional managed Tor client; executable path stays in local configuration.
# GIGACHAD_TOR_AUTOSTART=0
# GIGACHAD_TOR_PATH=C:\Path\To\tor.exe
